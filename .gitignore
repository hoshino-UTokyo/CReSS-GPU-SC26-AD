# =============================================================================
# .gitignore for CReSS-GPU-SC26-AD (main repo)
# Goal: ship source + specifications + small reference outputs only.
# =============================================================================

# ---------- Credentials & personal/agent state (CRITICAL) ----------
.credentials.json
**/.credentials.json
.claude/
**/.claude/
.claude.json
**/.claude.json
.history
.local/
.npm/
.cache/
Documents/
.nv/

# ---------- Build artefacts ----------
*.o
*.mod
*.exe
*.a
solver
solver_cpu
gridata.exe
unite.exe
EXE_noomp/

# ---------- Editor / OS junk ----------
*.bak
*~
*.swp
*.swo
.*.swp
.DS_Store
Thumbs.db

# ---------- Build/profiling logs ----------
build*.log
compile_output.log
process_kernels_output.log
*.nsys-rep
*.sqlite
*.ncu-rep
test_real/log.*.txt
test_real/log.*.err
*.pyc
__pycache__/

# ---------- Large binary simulation data ----------
# Inputs: GPV (199 MB; reproducible from external source, ship via separate DOI)
test_real/gpv/

# Per-kernel dump data (~419 GB)
test_real/kernel_dump/

# Simulation outputs (~18 GB). Keep only the small *.check.txt files.
test_real/result/*.bin
test_real/result/*.dmp*
test_real/result/*.gpv*
test_real/result/*.mon00*
test_real/result/TC2214.geography.pe*

# Per-kernel benchmark binaries / dump symlinks
Kernel_benchmark/*/kernel_benchmark
Kernel_benchmark/*/kernel_benchmark_*
Kernel_benchmark/*/generate_data
Kernel_benchmark/*/data
Kernel_benchmark/*/check_*

Kernel_benchmark_gpu/*/kernel_benchmark
Kernel_benchmark_gpu/*/kernel_benchmark_*
Kernel_benchmark_gpu/*/generate_data
Kernel_benchmark_gpu/*/data
Kernel_benchmark_gpu/*/check_*
Kernel_benchmark_gpu/*/debug_*
Kernel_benchmark_gpu/*/trace_*

Kernel_benchmark_gpu_opt/*/kernel_benchmark*
Kernel_benchmark_gpu_opt/*/data
Kernel_benchmark_gpu_opt/*/check_*
Kernel_benchmark_gpu_opt/*/debug_*
Kernel_benchmark_gpu_opt/*/trace_*
Kernel_benchmark_gpu_opt/roofline_job.log

# ---------- Backups / auto-generated copies ----------
Src.back.*/
SrcDevelop/
test_4d_dump/
*.tar.gz
!claude_logs.tar.gz
.git.backup-*/

# ---------- ISPACK is fetched by ispack_download.sh, do not bundle ----------
ISPACK/
Lib/
