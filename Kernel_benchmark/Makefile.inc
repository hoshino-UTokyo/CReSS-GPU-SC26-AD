#==============================================================================
# Kernel_benchmark common configuration
#
# References compile.conf_nvf for consistent compiler settings with Src
#==============================================================================

# Path to project root (relative from each benchmark directory)
PROJECT_ROOT = ../../..

# Compiler configuration file
COMPILE_CONF = $(PROJECT_ROOT)/compile.conf_nvf

# Extract settings from compile.conf_nvf
# FC: Use nvfortran directly (not mpifort) for single-node benchmarks
FC = nvfortran

# FFLAGS from compile.conf_nvf: -fast -mp -Mbyteswapio -mcmodel=medium
# -fast    : Optimization
# -mp      : OpenMP support
# -Mbyteswapio : Big-endian I/O (matches data generated by Src)
# -mcmodel=medium : Large memory model
FFLAGS = -fast -mp -Mbyteswapio -mcmodel=medium

# Additional flags for debugging (uncomment as needed)
# FFLAGS_DEBUG = -O0 -g -Minfo=all -Mbounds -traceback

# Linker flags
LDFLAGS = -fast -mp
