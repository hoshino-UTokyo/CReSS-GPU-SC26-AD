################################################################################
#                                                                              #
#     User configuration file, compile.conf                                    #
#                                                                              #
#     You can set the compile options.                                         #
#                                                                              #
#     Author      : SAKAKIBARA Atsushi                                         #
#     Date        : 1999/01/20                                                 #
#     Modification: 1999/01/25, 1999/11/19, 2002/06/17                         #
#     for ES2     : 2009/05/15, YOSHIOKA Mayumi                                #
#     for rad     : 2015/03/16, YOSHIOKA Mayumi                                #
#                                                                              #
################################################################################

##LDFLAGS = -L"${HOME}/CReSS/CReSS3.4.3m_RAD1.2.1_20140825/Src" -lrrtmg_kgkgb
LDFLAGS = -L"./" -lrrtmg_kgkgb

FFLAGS  = -gmalloc ${DEBUGS} -Wf"-msg b" -Wf"-msg d" -Wf"-msg o" -Wf"-pvctl fullmsg" ${ADDFLAGS}
DEBUGS  = -R5
ADDFLAGS = -Wf"-O extendreorder" -Wf"-pvctl cond_mem_opt"

#------------------------------------------------------------------------------#
#                                                                              #
# In the following section,                                                    #
#     if your machine's fortran compiler command is neither mpif90 nor f90,    #
#     you have to set the following macro to adjust.                           #
#                                                                              #
#------------------------------------------------------------------------------#
FC      =	/SX/usr/bin/sxmpif90
###FC      =	/ES/usr/bin/esmpif90

#------------------------------------------------------------------------------#
#                                                                              #
# In the following section,                                                    #
#     if your skip several times of compile for radiation block,               #
#     you should make a library pachage with rrtmg_*_k_g_kgb* subrouties.      #
#                                                                              #
#------------------------------------------------------------------------------#
AR = sxar

