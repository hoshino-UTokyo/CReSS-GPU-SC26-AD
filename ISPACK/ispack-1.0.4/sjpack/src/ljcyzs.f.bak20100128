************************************************************************
*     REPACKING SPECTRA TRANSFORM for y div (zonal component) 2009/08/17
************************************************************************
      SUBROUTINE LJCYZS(MM,SG,S,C)

      IMPLICIT REAL*8(A-H,O-Z)
      DIMENSION S(0:MM),SG(0:MM+1)
      DIMENSION C((MM+1)*(MM+1))

      N=0
      S(N)=-C(N+1)*SG(N+1)
      DO N=1,MM
        S(N)=-C(N+1)*SG(N+1)-C(MM+1+N)*SG(N-1)
      END DO
      
      END
