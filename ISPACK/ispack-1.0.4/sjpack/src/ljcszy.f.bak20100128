************************************************************************
*     REPACKING SPECTRA TRANSFORM for y grad (zonal component)
*                                                            2009 /08/17
*-----------------------------------------------------------------------      
      SUBROUTINE LJCSZY(MM,S,SG,C)

      IMPLICIT REAL*8(A-H,O-Z)
      DIMENSION S(0:MM),SG(0:MM+1)
      DIMENSION C((MM+1)*(MM+1))

      SG(0)=C(MM+1+1)*S(1)
      DO N=1,MM-1
        SG(N)=C(N)*S(N-1)+C(MM+1+N+1)*S(N+1)
      END DO
      SG(MM)=C(MM)*S(MM-1)
      SG(MM+1)=C(MM+1)*S(MM)

      END
